{% comment %}
Series Navigation Component
Only renders if page.series is defined and matches a series in _data/series.yml
{% endcomment %}

{% if page.series %}
{% if site.data.series[page.series] %}
{% assign series = site.data.series[page.series] %}
{% assign current_index = -1 %}
{% assign parts_count = series.parts | size %}

{% for part in series.parts %}
  {% if part.url == page.permalink %}
    {% assign current_index = forloop.index0 %}
  {% endif %}
{% endfor %}

{% if current_index >= 0 %}
{% assign prev_index = current_index | minus: 1 %}
{% assign next_index = current_index | plus: 1 %}
{% assign part_number = current_index | plus: 1 %}

<nav class="series-nav" style="display:flex; justify-content:space-between; align-items:center; padding:12px 20px; background:#fff; border-bottom:1px solid #e8e8e8; font-size:14px;">
  <div style="font-weight:500;">
    <a href="{{ site.baseurl }}/" style="color:#333; text-decoration:none;">{{ series.title }}</a>
  </div>
  <div style="display:flex; align-items:center; gap:20px;">
    {% if prev_index >= 0 %}
      <a href="{{ site.baseurl }}{{ series.parts[prev_index].url }}" style="color:#c040c0; text-decoration:none;">← Previous Part</a>
    {% else %}
      <span style="color:#999;">← Previous Part</span>
    {% endif %}
    
    {% if next_index < parts_count %}
      <a href="{{ site.baseurl }}{{ series.parts[next_index].url }}" style="color:#c040c0; text-decoration:none;">Next Part →</a>
    {% else %}
      <span style="color:#999;">Next Part →</span>
    {% endif %}
  </div>
</nav>

<div style="margin:16px 0 24px 0; padding:12px 16px; background:#fffbeb; border-radius:6px; font-size:14px;">
  Part {{ part_number }} of {{ parts_count }} in <a href="{{ site.baseurl }}/" style="color:#c040c0;">{{ series.title }}</a>
</div>

{% endif %}
{% endif %}
{% endif %}
